# Stock Training — env vars
# Copy to .env and fill

# Fuente 1-min (prioridad: Alpaca → Polygon → Yahoo)
# Alpaca (recomendado): datos profesionales, plan free, 7+ años histórico
ALPACA_API_KEY_ID=your_key_id
ALPACA_API_SECRET_KEY=your_secret_key
# ALPACA_ADJUSTED=false  # raw prices (sin ajuste splits), default: split

# Polygon.io (opcional)
# POLYGON_API_KEY=your_key
# POLYGON_ADJUSTED=false

# Yahoo: fallback si no hay Alpaca/Polygon. Limitado ~7 días, calidad variable.

# Finnhub — fundamentales (shareOutstanding). Requerido; Yahoo devuelve 401.
# Obtén token gratis en https://finnhub.io
FINNHUB_API_KEY=your_finnhub_token

# OpenAI (optional) — for LLM catalyst classification
OPENAI_API_KEY=your_key

# Principio de los días: solo procesar fechas >= esta fecha (YYYY-MM-DD).
# Si no se define, se procesan todas las fechas.
# DATA_FROM_DATE=2026-03-01

# OpenAI (optional) — for LLM catalyst classification
OPENAI_API_KEY=your_key

# Rango de fechas (YYYY-MM-DD). Si no se define DATA_TO_DATE, se usa la fecha de hoy.
DATA_FROM_DATE1=2025-09-01
DATA_FROM_DATE=2026-03-06
DATA_TO_DATE=

# CSV: true = sobrescribir, false = adicionar (para retomar si falla el procesamiento)
CSV_REWRITE=true

# Límite de entradas (símbolo+fecha) a procesar. Sin definir = sin límite. Ej: PROCESS_LIMIT=100 para pruebas.
# PROCESS_LIMIT=100

# Límite de entradas (símbolo+fecha) a procesar. Sin definir = sin límite. Ej: PROCESS_LIMIT=100 para pruebas.
# PROCESS_LIMIT=100

# Límite de entradas (símbolo+fecha) a procesar. Sin definir = sin límite. Usa 100 para pruebas rápidas.
# PROCESS_LIMIT=100

# Límite de entradas (símbolo+fecha) a procesar. Sin definir = sin límite. Ej: PROCESS_LIMIT=100 para pruebas.
# PROCESS_LIMIT=

# Límite de entradas (símbolo+fecha) a procesar. Sin definir = sin límite. Usa 100 para pruebas rápidas.
# PROCESS_LIMIT=100

