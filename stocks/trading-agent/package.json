{
  "name": "trading-agent",
  "version": "1.0.0",
  "description": "AI Trading RAG Agent with NestJS + LangChain + Qdrant",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch --builder swc",
    "start:prod": "node dist/src/main",
    "embed": "ts-node -r tsconfig-paths/register scripts/embed-knowledge.ts",
    "debug-metrics": "node scripts/debug-stock-metrics.js --",
    "debug-predict": "node scripts/debug-predict.js --"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@qdrant/js-client-rest": "^1.9.0",
    "@types/ioredis": "^4.28.10",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "ioredis": "^5.10.0",
    "langchain": "^0.3.0",
    "mysql2": "^3.19.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.18",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.0"
  }
}
