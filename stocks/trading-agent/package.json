{
  "name": "trading-agent",
  "version": "1.0.0",
  "description": "AI Trading RAG Agent with NestJS + LangChain + Qdrant",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch --builder swc",
    "start:prod": "node dist/src/main",
    "embed": "ts-node -r tsconfig-paths/register scripts/embed-knowledge.ts",
    "debug-metrics": "node scripts/debug-stock-metrics.js --",
    "debug-predict": "node scripts/debug-predict.js --",
    "debug-predict-csv": "node scripts/debug-predict-csv.js --",
    "debug-predict-screener": "node scripts/debug-predict-screener.js --",
    "debug-predict-csv-day-summary": "node scripts/debug-predict-csv-day-summary.js --",
    "verify-sync": "node scripts/verify-data-sync.js",
    "quick-test": "node scripts/quick-sync-test.js",
    "historical-test": "node scripts/historical-sync-test.js",
    "sync-help": "node scripts/sync-readme.js",
    "compare-ohlcv": "node scripts/exact-ohlcv-compare.js",
    "debug-dates": "node scripts/debug-date-ranges.js",
    "simple-dates": "node scripts/simple-date-debug.js",
    "verify-fixed": "node scripts/fixed-sync-verification.js",
    "test-websocket": "npm run build && node scripts/test-websocket.js"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/websockets": "^10.4.22",
    "@qdrant/js-client-rest": "^1.9.0",
    "@supercharge/promise-pool": "^3.3.0",
    "@types/ioredis": "^4.28.10",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "ioredis": "^5.10.0",
    "langchain": "^0.3.0",
    "mysql2": "^3.20.0",
    "node-notifier": "^10.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "ws": "^8.19.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.18",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.0"
  }
}
