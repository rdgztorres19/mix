# ── API ────────────────────────────────────────────────────────────────────
PORT=3100

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── momoscreener.com (no API key required) ─────────────────────────────────
MOMO_BASE_URL=https://momoscreener.com/api/p

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trading_knowledge

# ── Account defaults ───────────────────────────────────────────────────────
DEFAULT_ACCOUNT_SIZE=25000

# ── Scanner cron (weekdays 8:00 AM ET = 13:00 UTC) ─────────────────────────
SCANNER_CRON=0 13 * * 1-5

# ── Stock selection filters ────────────────────────────────────────────────
FILTER_PRICE_MIN=2          # minimum stock price ($)
FILTER_PRICE_MAX=20         # maximum stock price ($)
FILTER_CHANGE_PCT_MIN=0.10  # minimum daily change (0.10 = 10%)
FILTER_REL_VOL_MIN=5        # minimum relative volume (5x average)
FILTER_ATR_MIN=0.50         # minimum ATR in dollars

# ── Chart / analysis settings ──────────────────────────────────────────────
PRE_MARKET_HOUR_ET=4        # hour each trading day starts (ET); 4 = 4:00 AM pre-market
TRADING_DAYS_HISTORY=2      # how many trading days of candle data to load (default 2)
ATR_PERIOD=14               # candles used for ATR calculation
TOOL_CANDLES_SHOWN=15        # 5-min candles passed to the AI agent (0 = all candles from history window)

# ── Finnhub (fundamentals: shares_outstanding, market_cap for sync) ─────────
# Falls back to ../stock-training/.env if not set
# FINNHUB_API_KEY=your_key

# ── MySQL (stock-training historical data) ──────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=...
MYSQL_DATABASE_TRAINING=stock_training   # DB poblada por stock-training: npm run sync-mysql

# ── Alpaca screener (tables screener_* in same MySQL DB) ─────────────────────
# Market data (bars/snapshots): ALPACA_API_KEY_ID + ALPACA_API_SECRET_KEY (aliases: ALPACA_KEY_ID, ALPACA_SECRET_KEY)
# Paper API (assets list on paper-api.alpaca.markets): ALPACA_PAPER_API_KEY_ID + ALPACA_PAPER_API_SECRET_KEY
#   aliases: ALPACA_PAPER_KEY_ID + ALPACA_PAPER_SECRET_KEY
# Optional fallback file if unset: ../stock-training/.env
# Universe filters (same semantics as stock-training/scripts/download-gainers.ts):
# ONLY_ACTIVE=1
# ONLY_TRADABLE=1
# ONLY_US_EQUITY=1
# EXCLUDE_OTC_FROM_UNIVERSE=0
# SCREENER_CHUNK_SIZE=200
# SCREENER_CHUNK_CONCURRENCY=5
# SCREENER_TOP_N=40
# SCREENER_DB_BATCH_SIZE=500   # multi-row insert size for screener MySQL writes
# SCREENER_MAX_RETRIES=20

# ── Redis (news catalyst cache) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379   # Redis connection URL
NEWS_CACHE_TTL_SEC=30000            # seconds to cache news catalyst per ticker (0 = disabled)
