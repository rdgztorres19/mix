# ── API ────────────────────────────────────────────────────────────────────
PORT=3000

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── momoscreener.com (no API key required) ─────────────────────────────────
MOMO_BASE_URL=https://momoscreener.com/api/p

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trading_knowledge

# ── Account defaults ───────────────────────────────────────────────────────
DEFAULT_ACCOUNT_SIZE=25000

# ── Scanner cron (weekdays 8:00 AM ET = 13:00 UTC) ─────────────────────────
SCANNER_CRON=0 13 * * 1-5

# ── Stock selection filters ────────────────────────────────────────────────
FILTER_PRICE_MIN=2          # minimum stock price ($)
FILTER_PRICE_MAX=20         # maximum stock price ($)
FILTER_CHANGE_PCT_MIN=0.10  # minimum daily change (0.10 = 10%)
FILTER_REL_VOL_MIN=5        # minimum relative volume (5x average)
FILTER_ATR_MIN=0.50         # minimum ATR in dollars

# ── Chart / analysis settings ──────────────────────────────────────────────
PRE_MARKET_HOUR_ET=4        # hour each trading day starts (ET); 4 = 4:00 AM pre-market
TRADING_DAYS_HISTORY=2      # how many trading days of candle data to load (default 2)
ATR_PERIOD=14               # candles used for ATR calculation
TOOL_CANDLES_SHOWN=0        # 5-min candles passed to the AI agent (0 = all candles from history window)
