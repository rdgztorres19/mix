# ===========================================
# ALPACA WEBSOCKET CONFIGURATION
# ===========================================

# Enable/disable Alpaca WebSocket streaming
ALPACA_WEBSOCKET_ENABLED=true

# Symbols to subscribe to (comma-separated)
# Example: ACXP,AAPL,TSLA,CAMP
ALPACA_WEBSOCKET_SYMBOLS=ACXP

# WebSocket reconnection interval (milliseconds)
ALPACA_RECONNECT_INTERVAL_MS=5000

# Enable/disable fallback cron job
WEBSOCKET_FALLBACK_ENABLED=true

# Alpaca API credentials (already configured for REST API)
ALPACA_KEY_ID=PKBLVB6V5QWCSU2TLPHJ
ALPACA_SECRET_KEY=Vhuk22MepdEauPUtAmxGjfLRoARzwLBiiNvgjpbG

# ===========================================
# EXAMPLE USAGE:
# 1. Start trading agent: npm run start:dev
# 2. WebSocket auto-connects to SIP feed
# 3. Fallback cron runs every 61 seconds
# 4. Real-time bars logged to console
# ==========================================