{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Trading Agent",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "npx",
            "runtimeArgs": ["nest", "start", "--debug", "--watch", "--builder", "swc"],
            "cwd": "${workspaceFolder}/stocks/trading-agent",
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "killBehavior": "polite",
            "preLaunchTask": "Kill port 3033"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/csv-to-mqtt.js"
        }
    ]
}