# Azure AI Foundry Configuration
PROJECT_ENDPOINT=https://your-project.cognitiveservices.azure.com/
MODEL_DEPLOYMENT_NAME=your-model-deployment-name

# Server Configuration
SERVER_URL=127.0.0.1

# Agent Ports
TITLE_AGENT_PORT=3001
OUTLINE_AGENT_PORT=3002
ROUTING_AGENT_PORT=3000

# Azure Authentication
# The DefaultAzureCredential will use these in order:
# 1. Environment variables (AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
# 2. Managed Identity (if running in Azure)
# 3. Azure CLI (if logged in)
# 4. Visual Studio Code (if logged in)
# 5. Azure PowerShell (if logged in)

# Optional: If using Service Principal authentication, uncomment and fill:
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id